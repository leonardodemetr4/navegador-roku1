<?xml version="1.0" encoding="UTF-8"?>

<component name="MainScene"
           extends="Scene">

    <interface>
        <field id="serverUrl" type="string" />
    </interface>

    <children>

        <Rectangle
            id="background"
            width="1280"
            height="720"
            color="0x101010FF" />

        <Label
            id="title"
            text="NAVEGADOR ROKU"
            translation="[40,25]"
            font="font:LargeBoldSystemFont" />

        <Label
            id="urlLabel"
            text="Digite uma URL:"
            translation="[40,90]"
            font="font:MediumSystemFont" />

        <Label
            id="urlText"
            text="https://example.com"
            translation="[40,135]"
            width="1100"
            height="55"
            font="font:MediumSystemFont"
            color="0xFFFFFFFF" />

        <Button
            id="openButton"
            text="ABRIR"
            translation="[40,205]" />

        <Poster
            id="pageImage"
            translation="[40,280]"
            width="1200"
            height="400"
            loadDisplayMode="scaleToFit" />

        <Label
            id="status"
            text="Pronto"
            translation="[40,685]"
            font="font:SmallSystemFont" />

    </children>

    <script type="text/brightscript" uri="MainScene.brs" />

</component>
